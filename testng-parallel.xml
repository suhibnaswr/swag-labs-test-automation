<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
    parallel="classes":
    يسمح بتشغيل Test Classes المختلفة بالتوازي.

    thread-count="3":
    يسمح باستخدام ثلاثة Threads كحد أقصى.
-->
<suite name="Swag Labs Parallel Suite"
       parallel="classes"
       thread-count="3">

    <!-- تسجيل Listener الخاص بالنتائج والصور وAllure -->
    <listeners>
        <listener class-name="listeners.RetryTransformer"/>
        <listener class-name="listeners.TestListener"/>
    </listeners>

    <!-- جميع اختبارات المشروع -->
    <test name="Parallel Tests">

        <classes>

            <!-- قد يعمل هذا الكلاس داخل Thread مستقل -->
            <class name="tests.LoginTest"/>

            <!-- قد يعمل هذا الكلاس داخل Thread مستقل -->
            <class name="tests.ProductsTest"/>

            <!-- قد يعمل هذا الكلاس داخل Thread مستقل -->
            <class name="tests.CartTest"/>

            <!-- سيعمل عند توفر أحد الـThreads الثلاثة -->
            <class name="tests.CheckoutTest"/>

        </classes>

    </test>

</suite>
